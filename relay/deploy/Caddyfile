{
    admin off
    auto_https disable_redirects
    https_port 19443
    servers {
        protocols h1 h2
        listener_wrappers {
            proxy_protocol {
                timeout 5s
                allow 127.0.0.1/32
            }
            tls
        }
    }
}

face.debimarlene.com {
    bind 127.0.0.1
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    reverse_proxy 127.0.0.1:19444 {
        header_up X-Forwarded-For {remote_host}
        flush_interval -1
    }
}
